# Public URL of this server. Claude must be able to reach it, so use a tunnel
# (`cloudflared tunnel --url http://localhost:4000`) when testing locally.
PUBLIC_API_URL=http://localhost:4000
PORT=4000

# Leave unset to use the bundled Postgres in .data/postgres (no Docker needed).
DATABASE_URL=postgres://mcp:mcp@127.0.0.1:5434/mcp

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Channel3 product search (https://trychannel3.com, 1,000 free credits/month).
# Also powers the /shop page. Without a key, Claude gets a small built-in demo
# catalog and /shop says search isn't set up.
CHANNEL3_API_KEY=
# Channel3 dashboard webhook portal: register <PUBLIC_API_URL>/channel3/webhook and
# put its whsec_ signing secret here for price and availability alerts.
CHANNEL3_WEBHOOK_SECRET=

# PayPal sandbox REST app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: id of a webhook you add to that app (URL <PUBLIC_API_URL>/paypal/webhook) so
# orders turn Paid / Refunded on their own, even if the buyer closes the tab.
PAYPAL_WEBHOOK_ID=
# PAYPAL_ENV=sandbox

# Branding (optional). Defaults live in src/project/branding.ts.
# BRAND_NAME=Payout
# BRAND_ACCENT_COLOR=#2d2b28

# Proxy hops in front of this server (1 on Render/Fly/Railway, 0 if exposed directly).
# TRUST_PROXY=1
