{
  "name": "payout",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --ignore './.next/**' --ignore './src/app/**' --ignore './src/components/**' server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@channel3/sdk": "^4.5.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "embedded-postgres": "18.4.0-beta.17",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "19.3.1",
    "recharts": "3.8.0",
    "svix": "^2.9.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
